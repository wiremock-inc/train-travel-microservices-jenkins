{
  "mappings": [
    {
      "name": "newBooking webhook received",
      "priority": 5,
      "request": {
        "method": "POST",
        "urlPath": "/new-booking",
        "bodyPatterns": [
          {
            "matchesJsonPath": "$.id"
          },
          {
            "matchesJsonPath": "$.passenger_name"
          }
        ]
      },
      "response": {
        "status": 200
      }
    },
    {
      "name": "newBooking webhook rejected - not a booking payload",
      "priority": 9,
      "request": {
        "method": "POST",
        "urlPath": "/new-booking"
      },
      "response": {
        "status": 400,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\n  \"error\": \"The request body must be a booking with an id and passenger_name\"\n}"
      }
    }
  ]
}